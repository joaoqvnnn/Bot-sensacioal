# ============================================
# LARIZINHA STORE - ENVIRONMENT VARIABLES
# ============================================
# Copie este arquivo para .env e preencha com valores reais.
# NUNCA versione o arquivo .env real.

# ---------- APLICAÇÃO ----------
APP_NAME=LarizinhaStore
APP_ENV=development          # development | production
APP_DEBUG=false
LOG_LEVEL=INFO
TIMEZONE=America/Sao_Paulo

# ---------- TELEGRAM ----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_ADMIN_IDS=           # ex: 123456,789012
TELEGRAM_OWNER_ID=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=

# ---------- POSTGRESQL ----------
POSTGRES_DB=larizinha
POSTGRES_USER=larizinha
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_PORT=5432
POSTGRES_ECHO=false
POSTGRES_POOL_SIZE=10
POSTGRES_MAX_OVERFLOW=20
POSTGRES_SSL=false

# ---------- REDIS ----------
REDIS_PORT=6379
REDIS_PASSWORD=change_me_redis_password
REDIS_DB=0

# ---------- MERCADO PAGO (PIX) ----------
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_NOTIFICATION_URL=
MERCADO_PAGO_EXPIRATION_MINUTES=10
MERCADO_PAGO_MIN_DEPOSIT=1.00
MERCADO_PAGO_MAX_DEPOSIT=150.00

# ---------- WHATSAPP BUSINESS API ----------
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v18.0
WHATSAPP_ENABLED=false

# ---------- OPENAI / IA ----------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_ENABLED=false

# ---------- E-MAIL ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true

# ---------- WEBSITE / MINI APP ----------
BASE_URL=
FRONTEND_URL=
MINI_APP_URL=

# ---------- SEGURANÇA / CRIPTOGRAFIA ----------
SECRET_KEY=
ENCRYPTION_KEY=
HASH_ITERATIONS=100000

# ---------- OUTROS ----------
SUPPORT_CHAT_LINK=
DEFAULT_GIFT_BONUS=0
ALLOW_USER_REGISTRATION=true
